{
  "manifest_version": 3,
  "name": "Aguacate speaker names — development preview",
  "version": "0.1.0",
  "description": "Reads Google Meet speaking activity only while Aguacate is recording. Experimental; platform validation pending.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{"matches": ["https://meet.google.com/*"], "js": ["adapter.js", "content.js"], "run_at": "document_idle"}]
}
